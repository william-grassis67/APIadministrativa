# Exemplo de variáveis de ambiente para Render.com
# Copie este arquivo para .env.production e preencha os valores

# Spring Profile (não altere para Render)
SPRING_PROFILES_ACTIVE=prod

# Banco de Dados MySQL
# Formato: jdbc:mysql://host:porta/banco?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_URL=jdbc:mysql://localhost:3306/seu_banco?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USER=seu_usuario
DATABASE_PASSWORD=sua_senha

# JWT Secret (gere uma chave com pelo menos 32 caracteres)
JWT_SECRET=gere-uma-chave-aleatoria-com-32-caracteres-ou-mais-exemplo123456789

# JWT Expiration (em milissegundos, 86400000 = 24 horas)
JWT_EXPIRATION=86400000

# Opcional: Porta (Render.com define automaticamente via $PORT)
# PORT=8080
